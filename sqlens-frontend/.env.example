# Server-only URL for Next.js BFF route handlers that call FastAPI.
# Do not use a NEXT_PUBLIC_ prefix and do not place database or AI-provider secrets here.
SQLENS_FASTAPI_BASE_URL=http://localhost:8000

# Generate separate long random values for local development. The BFF shared
# secret must exactly match SQLens-backend/BFF_SHARED_SECRET.
SQLENS_BFF_SHARED_SECRET=replace-with-a-long-random-development-secret
SQLENS_SESSION_SECRET=replace-with-a-separate-long-random-session-secret

# Server-only AI provider configuration. Never expose this key with NEXT_PUBLIC_.
OPENROUTER_API_KEY=replace-with-openrouter-key
SQLENS_AI_MODEL=replace-with-approved-openrouter-model
