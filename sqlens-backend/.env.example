# PostgreSQL account for the SQLens application. Use separate migration and
# runtime roles in production; do not commit a real password.
DATABASE_URL=postgresql+psycopg://sqlens_app:replace-with-password@localhost:5432/sqlens

# Shared only between the Next.js BFF and FastAPI during development. Generate
# a long random value; never expose it with a NEXT_PUBLIC_ prefix.
BFF_SHARED_SECRET=replace-with-a-long-random-development-secret

# Limit any individual educational SELECT statement.
SQL_STATEMENT_TIMEOUT_MS=3000
